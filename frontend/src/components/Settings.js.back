import React, { useState, useEffect } from 'react';
import axios from 'axios';
import { useTranslation } from 'react-i18next';
import { Form, Button, Container } from 'react-bootstrap';

const Settings = () => {
  const { t } = useTranslation();
  const [form, setForm] = useState({ email: '', password: '' });
  const [voices, setVoices] = useState([]);
  const [englishVoice, setEnglishVoice] = useState(localStorage.getItem('englishVoice') || '');
  const [frenchVoice, setFrenchVoice] = useState(localStorage.getItem('frenchVoice') || '');

  useEffect(() => {
    const synth = window.speechSynthesis;
    const loadVoices = () => setVoices(synth.getVoices());
    synth.onvoiceschanged = loadVoices;
    loadVoices();
  }, []);

  const handleSubmit = async (e) => {
    e.preventDefault();
    try {
      await axios.put('http://localhost:5000/api/user/update', form);
      alert('Account updated');
    } catch (err) {
      console.error(err);
    }
  };

  const handleVoiceSubmit = (e) => {
    e.preventDefault();
    localStorage.setItem('englishVoice', englishVoice);
    localStorage.setItem('frenchVoice', frenchVoice);
    alert(t('voices_updated'));
  };

  return (
    <Container className="main-content mt-4">
      <h1>{t('settings')}</h1>
      <h2>{t('account')}</h2>
      <Form onSubmit={handleSubmit}>
        <Form.Group className="mb-3">
          <Form.Label>Email</Form.Label>
          <Form.Control type="email" value={form.email} onChange={(e) => setForm({ ...form, email: e.target.value })} />
        </Form.Group>
        <Form.Group className="mb-3">
          <Form.Label>Password</Form.Label>
          <Form.Control type="password" value={form.password} onChange={(e) => setForm({ ...form, password: e.target.value })} />
        </Form.Group>
        <Button variant="primary" type="submit">
          Update Account
        </Button>
      </Form>
      <h2 className="mt-4">{t('tts_settings')}</h2>
      <Form onSubmit={handleVoiceSubmit}>
        <Form.Group className="mb-3">
          <Form.Label>{t('english_voice')}</Form.Label>
          <Form.Select value={englishVoice} onChange={(e) => setEnglishVoice(e.target.value)}>
            <option>{t('select')}</option>
            {voices.filter(v => v.lang.startsWith('en')).map(v => <option key={v.name} value={v.name}>{v.name}</option>)}
          </Form.Select>
        </Form.Group>
        <Form.Group className="mb-3">
          <Form.Label>{t('french_voice')}</Form.Label>
          <Form.Select value={frenchVoice} onChange={(e) => setFrenchVoice(e.target.value)}>
            <option>{t('select')}</option>
            {voices.filter(v => v.lang.startsWith('fr')).map(v => <option key={v.name} value={v.name}>{v.name}</option>)}
          </Form.Select>
        </Form.Group>
        <Button variant="primary" type="submit">
          {t('save_voices')}
        </Button>
      </Form>
    </Container>
  );
};

export default Settings;