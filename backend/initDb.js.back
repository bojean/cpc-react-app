require('dotenv').config();
const pool = require('./db');

(async () => {
  try {
    await pool.query(`
      CREATE TABLE IF NOT EXISTS users (
        id SERIAL PRIMARY KEY,
        email VARCHAR(255) UNIQUE NOT NULL,
        password VARCHAR(255) NOT NULL
      );
      
      CREATE TABLE IF NOT EXISTS services (
        id SERIAL PRIMARY KEY,
        name VARCHAR(255) NOT NULL,
        code CHAR(1) NOT NULL,
        description TEXT,
        status BOOLEAN DEFAULT TRUE
      );

      
  CREATE TABLE IF NOT EXISTS orders (
    id SERIAL PRIMARY KEY,
    service_id INTEGER REFERENCES services(id),
    order_number int NOT NULL,
    code VARCHAR(20) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
  );

    `);
    // Insert a default admin user (hash password in production)
    const bcrypt = require('bcryptjs');
    const hashedPassword = await bcrypt.hash('123', 10);
    await pool.query('INSERT INTO users (email, password) VALUES ($1, $2) ON CONFLICT DO NOTHING', ['admin@cen.com',hashedPassword]);
    await pool.query(`ALTER TABLE users ADD COLUMN IF NOT EXISTS role VARCHAR(10) DEFAULT 'admin';`);
    console.log('Tables created');
  } catch (err) {
    console.error(err);
  } finally {
    process.exit();
  }
})();