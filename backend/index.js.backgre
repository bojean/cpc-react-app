// Next code for agent
app.get('/api/next-code', authenticate, async (req, res) => {
  const { id } = req.user;
  try {
    // Get agent's assigned caisse/box
    const assignment = await pool.query('SELECT assignee_id FROM assignments WHERE type = \'agent_station\' AND assigner_id = $1', [id]);
    if (assignment.rows.length === 0) return res.status(404).json({ message: 'No assignment' });
    const stationId = assignment.rows[0].assignee_id;
    const station = await pool.query('SELECT type FROM services WHERE id = $1', [stationId]);
    if (station.rows.length === 0) return res.status(404).json({ message: 'Station not found' });
    const stationType = station.rows[0].type;

    let query = '';
    let params = [];
    if (stationType === 'caisse') {
      // Check if caisse has specific service assignments
      const services = await pool.query('SELECT assignee_id FROM assignments WHERE type = \'caisse_service\' AND assigner_id = $1', [stationId]);
      if (services.rows.length > 0) {
        // Caisse has specific services assigned
        const serviceIds = services.rows.map(s => s.assignee_id);
        query = `SELECT o.*, s.name as service_name, s.code as service_code
                 FROM orders o
                 JOIN services s ON o.service_id = s.id
                 WHERE o.service_id IN (${serviceIds.join(',')}) AND o.status = 'pending'
                 ORDER BY o.created_at LIMIT 1`;
      } else {
        // Caisse can call any normal service code
        query = `SELECT o.*, s.name as service_name, s.code as service_code
                 FROM orders o
                 JOIN services s ON o.service_id = s.id
                 WHERE o.status = 'pending' AND s.type = 'normal'
                 ORDER BY o.created_at LIMIT 1`;
      }
    } else if (stationType === 'box') {
      // Redirected codes for box
      query = `SELECT o.*, s.name as service_name, s.code as service_code
               FROM orders o
               JOIN services s ON o.service_id = s.id
               WHERE o.service_id = $1 AND o.status = 'redirected'
               ORDER BY o.created_at LIMIT 1`;
      params = [stationId];
    } else {
      return res.status(400).json({ message: 'Invalid station type' });
    }

    const result = await pool.query(query, params);
    if (result.rows.length === 0) return res.status(404).json({ message: 'No next code' });
    const nextOrder = result.rows[0];
    await pool.query('UPDATE orders SET called_at = CURRENT_TIMESTAMP, status = \'called\' WHERE id = $1', [nextOrder.id]);
    res.json(nextOrder);
  } catch (err) {
    res.status(500).json({ message: err.message });
  }
});

const port = process.env.PORT || 5000;
app.listen(port, () => console.log(`Server running on port ${port}`));